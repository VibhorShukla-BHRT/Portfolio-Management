# ==============================================================================
# Environment Configuration Template for Multi-Agent Portfolio System
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: OpenRouter (Cloud LLM API - Recommended for Quick Testing)
# ------------------------------------------------------------------------------
# Get your free or paid API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Specify an OpenRouter model (defaults to openrouter/openrouter/free)
# Examples: openrouter/openrouter/free, meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
# OPENROUTER_MODEL=openrouter/openrouter/free


# ------------------------------------------------------------------------------
# OPTION B: Custom Self-Hosted / Local LLM Endpoint (e.g. Ollama, vLLM, Kaggle)
# ------------------------------------------------------------------------------
# To use a local or self-hosted endpoint, uncomment the lines below:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=ollama/ritu-27b:latest
# LLM_API_KEY=ollama
